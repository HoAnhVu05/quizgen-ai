# ========================================================
# QUIZGEN AI - CENTRAL MICROSERVICES CONFIGURATION
# ========================================================

# General & Security
SECRET_KEY=quizgen-super-secret-academic-key-2026
ENVIRONMENT=development

# Google OAuth 2.0 (Sign in with Google)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email SMTP Configuration (Gmail for OTP & Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=quizgen.ai.team@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_NAME=QuizGen AI — Cổng Khảo thí & Ngân hàng Đề thi Học thuật

# LLM Providers
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Microservices Network Routing
GATEWAY_PORT=8000
AUTH_SERVICE_URL=http://localhost:8001
DOCUMENT_SERVICE_URL=http://localhost:8002
RAG_SERVICE_URL=http://localhost:8003
AI_SERVICE_URL=http://localhost:8004
EXAM_SERVICE_URL=http://localhost:8005

# Relational Database (PostgreSQL 16)
POSTGRES_USER=quizgen
POSTGRES_PASSWORD=quizgen_secure_pass_2026
POSTGRES_DB=quizgen_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://quizgen:quizgen_secure_pass_2026@localhost:5432/quizgen_db

# Vector Database (Chroma / Qdrant)
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Cache & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
